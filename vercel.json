{
  "rewrites": [
    { "source": "/", "destination": "/entry.html" },
    { "source": "/((?!entry\\.html|eanova-logo\\.png|manifest\\.json|favicon\\.ico|favicon-32x32\\.png).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/entry.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
