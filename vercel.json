{
  "rewrites": [
    { "source": "/entry", "destination": "/entry.html" },
    { "source": "/entry.html", "destination": "/entry.html" },
    { "source": "/((?!entry\\.html|index\\.html|eanova-logo\\.png|.*\\.js|.*\\.css|.*\\.json).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/entry.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
